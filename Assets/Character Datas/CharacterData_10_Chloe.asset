  - "\u79C1\u306E\u8EFD\u8584\u306A\u96F0\u56F2\u6C17\u306B\u5408\u3046\u7537\u6027\u3001\u79C1\u3092\u7B11\u308F\u305B\u3066\u304F\u308C\u308B\u7537\u6027\u3001\u305D\u3057\u3066\u3042\u308A\u306E\u307E\u307E\u306E\u79C1\u3092\u611B\u3057\u3066\u304F\u308C\u308B\u7537\u6027\u304C\u6B32\u3057\u3044\u3002"
  - "\uB0B4 \uC7A5\uB09C\uAE30 \uB118\uCE58\uB294 \uBD84\uC704\uAE30\uC640 \uC798
    \uC5B4\uC6B8\uB9AC\uACE0, \uB098\uB97C \uC6C3\uAC8C \uD574\uC8FC\uACE0, \uC788\uB294
