  - "\u0E2D\u0E22\u0E32\u0E01\u0E40\u0E08\u0E2D\u0E43\u0E04\u0E23\u0E2A\u0E31\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E40\u0E15\u0E49\u0E19\u0E41\u0E23\u0E07
    \u0E41\u0E25\u0E30\u0E21\u0E32\u0E23\u0E48\u0E27\u0E21\u0E01\u0E31\u0E19\u0E2A\u0E33\u0E23\u0E27\u0E08\u0E2A\u0E34\u0E48\u0E07\u0E1A\u0E49\u0E32\u0E04\u0E25\u0E31\u0E48\u0E07\u0E17\u0E35\u0E48\u0E40\u0E23\u0E35\u0E22\u0E01\u0E27\u0E48\u0E32\u0E04\u0E27\u0E32\u0E21\u0E23\u0E31\u0E01\u0E19\u0E35\u0E49\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19"
  - "\u79C1\u306E\u5FC3\u3092\u3068\u304D\u3081\u304B\u305B\u3066\u304F\u308C\u308B\u4EBA\u3092\u898B\u3064\u3051\u3066\u3001\u611B\u3068\u547C\u3070\u308C\u308B\u3053\u306E\u4E0D\u601D\u8B70\u306A\u3082\u306E\u3092\u4E00\u7DD2\u306B\u63A2\u6C42\u3057\u305F\u3044\u3002"
  - "\uB0B4 \uC2EC\uC7A5\uC744 \uB6F0\uAC8C \uD558\uB294 \uC0AC\uB78C\uC744 \uB9CC\uB098\uC11C
    \uC774 \uBBF8\uCE5C \uC0AC\uB791\uC774\uB77C\uB294 \uAC10\uC815\uC744 \uD568\uAED8
    \uD0D0\uD5D8\uD558\uACE0 \uC2F6\uC5B4\uC694."
  - "\u092E\u0948\u0902 \u0915\u093F\u0938\u0940 \u0910\u0938\u0947 \u0935\u094D\u092F\u0915\u094D\u0924\u093F
